# ---------------------------------------------------------------------------
# Redirects — must come before the SPA catch-all below.
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Canonical host: www → apex. HTTPS is assumed (the host already terminates TLS).
  RewriteCond %{HTTP_HOST} ^www\.alisbarbershop\.com$ [NC]
  RewriteRule ^(.*)$ https://alisbarbershop.com/$1 [R=301,L]

  # /location used to be a client-side window.location.replace inside React,
  # which meant crawlers got a blank page carrying the homepage's canonical tag
  # and users waited for the JS bundle before being redirected. A real 301 is
  # both correct for SEO and instant.
  RewriteRule ^location/?$ "https://www.google.com/maps?cid=15098769549046085973&g_mp=CiVnb29nbGUubWFwcy5wbGFjZXMudjEuUGxhY2VzLkdldFBsYWNlEAMYASAF&hl=en&gl=US&source=embed" [R=301,L,NE]
</IfModule>

# ---------------------------------------------------------------------------
# Compression. LiteSpeed/Apache on most shared hosts honour this; if the host
# already compresses, this is a harmless no-op.
# ---------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ---------------------------------------------------------------------------
# Caching.
#
# The split matters: files under /assets/ carry a content hash in their name,
# so a change always produces a new URL and they can be cached forever.
# Everything in the site root (hero images, icons, og-image) keeps its filename
# across deploys, so an immutable year-long cache there would strand returning
# visitors on stale files. index.html must always be revalidated or nobody
# picks up a new build at all.
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Unhashed root assets — a week, revalidated after that.
  <FilesMatch "\.(webp|jpe?g|png|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>

  <FilesMatch "^(index\.html|404\.html|robots\.txt|sitemap\.xml|llms\.txt)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # Hashed build output overrides the image rule above for anything in /assets/.
  <IfModule mod_setenvif.c>
    SetEnvIf Request_URI "^/assets/" HASHED_ASSET=1
    Header set Cache-Control "public, max-age=31536000, immutable" env=HASHED_ASSET
  </IfModule>
</IfModule>

# ---------------------------------------------------------------------------
# Real 404s. This site has one indexable URL (/). The old SPA catch-all served
# index.html at HTTP 200 for every unknown path — a soft-404 that competed
# with the homepage. Existing files (hashed assets, sitemap, robots, images)
# are still served as files. Everything else is a genuine 404.
# ---------------------------------------------------------------------------
ErrorDocument 404 /404.html

